# --- Pulsar Lab Control Plane (pulsarlab.cl / npm run dev:pulsar) ---
# When PULSAR_SUPABASE_URL and PULSAR_SUPABASE_SERVICE_ROLE_KEY are set, the runtime
# loads `public.platform_tenants` from the Pulsar Supabase database (60s TTL cache)
# so adding or editing a tenant in `/es/admin` requires no Vercel redeploy.
# PULSAR_SUPABASE_URL=https://your-pulsar-project.supabase.co
# PULSAR_SUPABASE_ANON_KEY=sb_publishable_...
# PULSAR_SUPABASE_SERVICE_ROLE_KEY=eyJ...
# PULSAR_DATABASE_URL=postgresql://postgres:PASS@db.your-pulsar-project.supabase.co:5432/postgres
# PULSAR_HOSTS=pulsarlab.cl,www.pulsarlab.cl

# --- Single-project multi-tenant config (.env.local) ---
# One `.env.local` (and one Vercel project) holds `TENANTS_CONFIG_JSON` with every institute.
# `npm run dev:<slug>` (or `npm run dev`) reads `.env.local` and sets `DEV_TENANT_SLUG=<slug>` for the process without overwriting `.env.local`.
# TENANTS_CONFIG_JSON=[{"slug":"nago","hosts":["capoeiranago.cl","www.capoeiranago.cl"],"supabaseUrl":"https://PROJECT.supabase.co","supabaseAnonKey":"sb_publishable_...","supabaseServiceRoleKey":"eyJ...","databaseUrl":"postgresql://postgres:PASS@db.PROJECT.supabase.co:5432/postgres","brandThemeSlug":"nago","mailTenant":"capoeiranago.cl","resendFromEmail":"info@capoeiranago.cl","resendApiKey":"re_xxx","publicUrl":"https://www.capoeiranago.cl","googleMapsApiKey":"AIza_xxx","debugLogin":true}]
# DEV_TENANT_SLUG=nago

# Otro Vercel + otra BD: leer marca y overrides del tema con este slug (servidor).
# Requiere SUPABASE_SERVICE_ROLE_KEY. En Golden no definas esto; activá solo el tema en CMS.
# El wizard /setup/first-run persiste en la misma fila que este slug (no solo en is_active).
# SITE_BRAND_THEME_SLUG=mozarthitos
# SITE_BRAND_THEME_SLUG=espaciozenit
# SITE_BRAND_THEME_SLUG=nago
# SITE_BRAND_THEME_SLUG=liora
# mimundo usa Supabase dedicado → no necesita SITE_BRAND_THEME_SLUG (es el único tema activo)

# Supabase (URL + one publishable/anon key — required for browser + middleware)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Legacy JWT “anon” key (API Settings → anon public) — still widely used
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# New Supabase “publishable” key (sb_publishable_…) — dashboard may only show this
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional fallbacks
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase service role — solo servidor (importación masiva / admin API). Nunca NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Payment gateways (Flow Chile, etc.): AES-256 key used to encrypt provider API secrets at rest in Postgres (32 raw bytes as Base64).
# Generate: openssl rand -base64 32
# Product multi-tenant deploys store this on each object as paymentGatewaySecretEncryptionKey.
# The loose key below is only for single-tenant / isolated E2E (TENANTS_CONFIG_JSON unset).
# Flow webhooks need a public HTTPS URL (set NEXT_PUBLIC_APP_URL correctly in each environment; use a tunnel such as ngrok for local sandbox callbacks).
# PAYMENT_GATEWAY_SECRET_ENCRYPTION_KEY=

# Supabase — server-only Postgres URL for scripts (psql migrations, tooling).
# Direct (default in dashboard copy):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
# If `nslookup db.your-project.supabase.co` fails but `your-project.supabase.co` works:
# Dashboard → Connect → Session pooler (host aws-0-<REGION>.pooler.supabase.com, user postgres.<ref>).
# https://supabase.com/docs/guides/database/connecting-to-postgres#pooler-session-mode
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Resend (server-only)
RESEND_API_KEY=re_your_api_key_here
# Verified sender domain in Resend (e.g. notifications@yourdomain.com) — required for outbound mail
RESEND_FROM_EMAIL=notifications@yourdomain.com
# Isolated E2E (`.env.local.e2e`): do NOT set RESEND_*. Use EMAIL_PROVIDER=recording
# (auto-written by `npm run e2e:stack:up` / forced by `test:e2e:precommit`).
# EMAIL_PROVIDER=recording

# App — use the real origin in production (SEO: canonical, OG, sitemap, JSON-LD)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Skip forcing `/dashboard/admin/site-setup` (greenfield wizard gate). Use only for CI/e2e.
# SKIP_INITIAL_SITE_SETUP=1

# Browser: extra login trace logs (`[goldenenglish:login]`). Failures always use console.error regardless.
# NEXT_PUBLIC_DEBUG_LOGIN=true

# Minors: profile self-edit of sensitive fields is blocked in Postgres when a tutor link exists (migration 015).
# Supabase Auth login email is not covered by that trigger; use an Auth hook or admin-only email change if you need the same rule for auth email.

# Vercel KV / Upstash (optional) — CSV import progress in admin.
# Product multi-tenant deploys store kvRestApiUrl and kvRestApiToken on each institute object.
# The loose keys below are only for single-tenant / isolated E2E (TENANTS_CONFIG_JSON unset).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cron (e.g. Vercel Cron → GET /api/cron/churn-inactivity) — protect the route
# CRON_SECRET=your-long-random-secret

# WhatsApp Cloud API (optional — class reminder urgent messages). Template must match body param count/order.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_CLASS_REMINDER_TEMPLATE_NAME=

# Google Maps — browser autocomplete + client geocoder preview on profile address.
# Product multi-tenant deploys store googleMapsApiKey and googleMapsMapId on each institute object.
# Restrict the key by HTTP referrer in Google Cloud. Enable Maps JavaScript API, Places API (New), and Geocoding API.
# The loose keys below are only for single-tenant / isolated E2E (TENANTS_CONFIG_JSON unset).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for vector maps + Advanced Marker preview (home address map). Create in Cloud Console → Map Management; falls back to DEMO_MAP_ID if unset (testing only).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Public registration / admin create — synthetic Auth emails (server-only; no scheme, e.g. alumnos.your-institute.cl):
#   • Minor student without email → local-part@MAIL_TENANT
#   • Parent/tutor without email → {dni}@parents.<MAIL_TENANT>
# Required on every multi-tenant deploy that creates minors or guardians without a real email.
# MAIL_TENANT=alumnos.your-institute.cl

# Web Push (PWA) — VAPID keys for browser push notifications. Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=notifications@yourdomain.com

# Playwright — isolated E2E (`docs/runbooks/e2e-isolated-harness.md`).
# Preferred: local Supabase via Docker — `npm run e2e:stack:up` writes `.env.local.e2e`.
#   brew install colima docker && colima start && npm run e2e:stack:up
# Precommit runs ALL e2e fail-closed. Escape: SKIP_E2E=1 (ask user first).
# Manual keys only if not using e2e:stack:up:
# E2E_STACK=isolated
# GE_DEV_TARGET=e2e
# E2E_ADMIN_EMAIL=e2e-admin@example.test
# E2E_ADMIN_PASSWORD=E2eLocal!Stack1
# E2E_LOCALE=es
# E2E_PORT=3100
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100


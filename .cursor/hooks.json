{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/sdd-gate0-pre-tool-use.mjs",
        "matcher": "Write|StrReplace|Delete",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/sdd-gate0-before-shell.mjs",
        "failClosed": false
      }
    ]
  }
}
